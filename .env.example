# Configuración local de XAMPP. Copiar a .env y ajustar sin subir credenciales a Git.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pokemarket
DB_USER=root
DB_PASSWORD=
# Ruta absoluta al certificado CA para conexiones TLS. Dejar vacío para XAMPP local.
DB_SSL_CA=
APP_ORIGINS=http://localhost,http://localhost:8000,http://127.0.0.1:8000
SESSION_SECURE=false
SESSION_IDLE_SECONDS=3600
MAIL_FROM=
MAIL_SMTP_HOST=smtp.hostinger.com
MAIL_SMTP_PASSWORD=
ACCOUNT_SECURITY_KEY=
POKEAPI_URL=https://pokeapi.co/api/v2
POKEMON_SERVICE_URL=http://localhost:8001/pokemon-api/v1
TRAINER_SERVICE_URL=http://localhost:8002/trainer-api/v1
# Genera una clave con php -r "echo bin2hex(random_bytes(32));"
GATEWAY_JWT_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/entrenadores/auth/google-callback
